// Cloudflare Worker that serves the Astro build as static assets.
// No script: Workers Static Assets serves ./dist (the output of `astro build`)
// directly, applying the _headers and _redirects that Astro copies in from
// public/. Workers Builds runs `npm run build` then `npx wrangler deploy` on
// every push to main (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (src/pages/404.astro) with a 404 status for any
    // path that has no asset.
    "not_found_handling": "404-page",
    // Astro builds about.astro to about.html (build.format "file") and the
    // site uses trailingSlash "never": /about serves it, /about/ redirects
    // to /about.
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
