// Cloudflare Worker that serves the portfolio as static assets.
// No script: Workers Static Assets serves ./public directly, applying
// public/_headers and public/_redirects. Workers Builds deploys this on every
// push to main (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // Serve public/404.html with a 404 status for any path that has no asset.
    "not_found_handling": "404-page",
    // /about -> /about/ (and /about/index.html) the way GitHub Pages did.
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
