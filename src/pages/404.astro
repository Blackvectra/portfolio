---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested does not exist." noindex>
  <div class="container">
    <section class="section prose">
      <h1>Page not found</h1>
      <p class="lede">That page does not exist or has moved.</p>
      <p>
        Try the <a href="/">home page</a>, <a href="/projects/">projects</a>, or <a href="/writing/">writing</a>.
      </p>
    </section>
  </div>
</BaseLayout>
