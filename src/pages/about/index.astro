---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaybeLink from '../../components/MaybeLink.astro';
import { links, site } from '../../data/site';
import { certificationsLine } from '../../data/certifications';

const focusAreas = [
  {
    title: 'Identity',
    text: 'Microsoft Entra ID and Microsoft 365 tenant security, reviewed through read-only assessment.',
    detail:
      'Conditional Access and MFA posture, checked with read-only Microsoft Graph tooling: which users are still on SMS or voice ahead of Microsoft retiring both, whether the passkey method they are being moved to is actually enabled and in scope for them, and where a policy exists on paper but is not enforced.',
  },
  {
    title: 'Endpoint',
    text: 'Microsoft Intune and Defender for Endpoint on Windows 11.',
    detail:
      'Settings Catalog baselines curated from CIS, the CISA Secure Configuration Baseline and the HIPAA Security Rule, Attack Surface Reduction rule sets tuned to the client (healthcare EHR, law firm, AVD), and compliance, LAPS and antivirus checks read the way Maester reads them, with a dry run before anything is applied.',
  },
  {
    title: 'Email Security',
    text: 'SPF, DKIM, DMARC, MTA-STS, and DANE, with a focus on getting domains to DMARC enforcement.',
    detail:
      'Deployed end to end on domains I run: DMARC at p=reject with strict alignment, MTA-STS in enforce mode with TLS-RPT, and DNSSEC with Exchange Online’s DNSSEC-aware MX endpoint, then written up as a repeatable framework with the DNS records, the PowerShell, and the validation steps.',
  },
];

const background = [
  {
    label: 'Current role',
    text: 'Security engineer at NRG Technology Services, a managed service provider: threat intelligence, incident response, endpoint security, and Microsoft 365 and Entra ID administration across client tenants.',
  },
  {
    label: 'Education',
    text: 'M.S. in Cyber Security, University of North Dakota (in progress).',
  },
  {
    label: 'Certifications',
    text: `${certificationsLine}.`,
  },
];
---
<BaseLayout
  title="About"
  description="About Matthew Levorson, security engineer based in North Dakota: identity, endpoint and email security on Microsoft 365."
>
  <div class="wrap">
    <section class="section prose">
      <h1>About</h1>
      <p class="lede">
        I'm {site.name}, a security engineer based in {site.location}. I work on Microsoft 365 and
        Entra security, enterprise email security, and DMARC enforcement, and I write up what I build.
      </p>
      <h2>Background</h2>
      <ul>
        {background.map((item) => (
          <li>
            <strong>{item.label}:</strong> {item.text}
          </li>
        ))}
      </ul>
      <p>
        Elsewhere: <MaybeLink href={links.linkedin}>LinkedIn</MaybeLink> &middot; <MaybeLink href={links.github}>GitHub</MaybeLink>
      </p>
    </section>

    <section aria-labelledby="focus-heading">
      <h2 id="focus-heading">Focus areas</h2>
      <ul class="focus-grid">
        {
          focusAreas.map((area) => (
            <li class="card">
              <h3>{area.title}</h3>
              <p>{area.text}</p>
              <p>{area.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
