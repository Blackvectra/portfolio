---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaybeLink from '../../components/MaybeLink.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Summary from '../../components/Summary.astro';
import WorkWithMe from '../../components/WorkWithMe.astro';
import { projects } from '../../data/projects';
---
<BaseLayout
  title="Projects"
  description="Projects by Matthew Levorson: email security on a self-managed domain, a read-only Microsoft 365 and Entra assessment tool, and a DMARC enforcement methodology."
>
  <div class="wrap">
    <section class="section">
      <h1>Projects</h1>
      <p class="lede">
        Work I build and document in the open. Each entry shows its current status and links to the
        full write-up or code when it exists.
      </p>
      <ul class="entry-list">
        {
          projects.map((project) => (
            <li>
              <article class="entry" id={project.id} aria-labelledby={`${project.id}-title`}>
                <h2 id={`${project.id}-title`}>{project.title}</h2>
                <ul class="tags" aria-label="Topics">
                  {project.topics.map((topic) => <li>{topic}</li>)}
                </ul>
                <Summary text={project.summary} />
                <div class="entry__meta">
                  <StatusBadge status={project.status} />
                  <MaybeLink href={project.link}>{project.linkLabel}</MaybeLink>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
    <WorkWithMe />
  </div>
</BaseLayout>
