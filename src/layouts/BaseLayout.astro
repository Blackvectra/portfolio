---
// Base page shell. No inline scripts or styles: global CSS is bundled to an
// external file (build.inlineStylesheets = "never") and the theme script is
// a static file in /public loaded with a src attribute.
// Self-hosted fonts (copied into dist/_astro, so font-src 'self' holds).
// Newsreader with its optical-size axis, upright and italic; Plex Mono at the
// two weights the labels use.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// tailwind.css imports global.css into a cascade layer and adds Tailwind's
// utilities above it; it is the one stylesheet entry.
import '../styles/tailwind.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { links, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Set on writing entries: marks the page as an article with this date. */
  published?: Date;
  /** Adds the Person structured data (Home and About). */
  person?: boolean;
}

const { title, description = site.description, noindex = false, published, person = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Security engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og.png', Astro.site);

// Structured data (schema.org JSON-LD). A JSON-LD block is data, not script:
// the browser never executes it, so script-src 'self' is unaffected, and
// check-inline allows this one type. "<" is escaped so no value can close
// the element.
const author = {
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
};
const personData = {
  '@context': 'https://schema.org',
  ...author,
  jobTitle: site.role,
  image: new URL('/portrait.jpg', Astro.site).href,
  sameAs: [links.linkedin, links.github],
};
const articleData = published && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published.toISOString().slice(0, 10),
  author,
  image: shareImage.href,
  mainEntityOfPage: canonical.href,
};
const structured: object[] = [];
if (person) structured.push(personData);
if (articleData) structured.push(articleData);
const toJsonLd = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role.toLowerCase()}`} />
    {published && <meta property="article:published_time" content={published.toISOString().slice(0, 10)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((data) => <script is:inline type="application/ld+json" set:html={toJsonLd(data)} />)}
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
