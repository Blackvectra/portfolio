---
import MaybeLink from './MaybeLink.astro';
import { links, site } from '../data/site';

interface Props {
  heading?: string;
}

const { heading = 'Work with me' } = Astro.props;
---
<section class="cta" aria-labelledby="work-with-me">
  <h2 id="work-with-me">{heading}</h2>
  <p>
    Consulting runs through {site.business}: Microsoft 365 and Entra security assessments, enterprise
    email security, and DMARC enforcement. Engagement details are on the NextlayerSec site.
  </p>
  <div class="cta__actions">
    <a class="button" href={links.nextlayersec}>Work with me</a>
    <MaybeLink class="button button--secondary" href={links.booking}>Book a call</MaybeLink>
    <MaybeLink class="button button--secondary" href={links.linkedin}>LinkedIn</MaybeLink>
  </div>
</section>
