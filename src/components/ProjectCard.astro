---
import StatusBadge from './StatusBadge.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
// The home page shows one sentence per project; the full paragraph is on
// /projects/, which the title links to. A placeholder, if one is ever
// reintroduced, ends the lead before it.
const placeholderAt = project.summary.indexOf('[');
const text = (placeholderAt > 0 ? project.summary.slice(0, placeholderAt) : project.summary).trim();
const lead = (text.match(/^[^.!?]+[.!?]+(?=\s|$)/)?.[0] ?? text).trim();
---
<article class="card">
  <StatusBadge status={project.status} />
  <h3><a href={`/projects/#${project.id}`}>{project.title}</a></h3>
  <p>{lead}</p>
</article>
