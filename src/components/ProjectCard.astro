---
// Home page card. Built to be skimmed: status and category, the title, one
// sentence on what it is, the problem, what I delivered, the topics, and a
// clear destination. The full entry is on /projects/, which the title links to.
import StatusBadge from './StatusBadge.astro';
import { isLink } from '../data/site';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
// A placeholder, if one is ever reintroduced, ends the lead before it.
const placeholderAt = project.summary.indexOf('[');
const text = (placeholderAt > 0 ? project.summary.slice(0, placeholderAt) : project.summary).trim();
const lead = (text.match(/^[^.!?]+[.!?]+(?=\s|$)/)?.[0] ?? text).trim();
const isSource = /^https:\/\/github\.com\//.test(project.link);
---
<article class="card">
  <p class="card__head">
    <span class="mono muted">{project.category}</span>
    <StatusBadge status={project.status} />
  </p>
  <h3><a href={`/projects/#${project.id}`}>{project.title}</a></h3>
  <p>{lead}</p>
  <dl class="card__facts">
    <div>
      <dt>Problem</dt>
      <dd>{project.problem}</dd>
    </div>
    <div>
      <dt>I built</dt>
      <dd>{project.deliverable}</dd>
    </div>
  </dl>
  <ul class="tags" aria-label="Topics">
    {project.topics.map((topic) => <li>{topic}</li>)}
  </ul>
  <p class="card__links">
    {
      isLink(project.link) && (
        <a href={project.link}>
          {isSource ? 'View source' : project.linkLabel}<span aria-hidden="true"> ↗</span>
          <span class="visually-hidden">: {project.title}</span>
        </a>
      )
    }
    <a href={`/projects/#${project.id}`}>
      Details<span aria-hidden="true"> →</span>
      <span class="visually-hidden">: {project.title}</span>
    </a>
  </p>
</article>
