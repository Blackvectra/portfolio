---
import MaybeLink from './MaybeLink.astro';
import { links, site } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p>&copy; {year} {site.name}. {site.location}.</p>
    <nav aria-label="Elsewhere">
      <ul>
        <li><a href={links.nextlayersec}>NextLayerSec</a></li>
        <li><MaybeLink href={links.linkedin}>LinkedIn</MaybeLink></li>
        <li><MaybeLink href={links.github}>GitHub</MaybeLink></li>
      </ul>
    </nav>
  </div>
</footer>
